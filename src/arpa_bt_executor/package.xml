<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arpa_bt_executor</name>
  <version>0.1.0</version>
  <description>Behavior tree executor for constrained screw placement sequence (3cm drop, 4s wait, constrained transfer).</description>
  <maintainer email="zackallen@example.com">Zack Allen</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>arpa_control</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

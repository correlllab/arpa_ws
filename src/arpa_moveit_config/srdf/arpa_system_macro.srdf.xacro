<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="arpa_system" params="name prefix">
    <group name="${prefix}${name}ur_manipulator">
      <chain base_link="${prefix}base_link" tip_link="${prefix}tool0"/>
    </group>
    <group name="${prefix}end_effector">
      <chain base_link="${prefix}tool0" tip_link="${prefix}tool_head_link"/>
    </group>
    <group_state group="ur_manipulator" name="home">
      <joint name="elbow_joint" value="0"/>
      <joint name="shoulder_lift_joint" value="-1.5707"/>
      <joint name="shoulder_pan_joint" value="0"/>
      <joint name="wrist_1_joint" value="0"/>
      <joint name="wrist_2_joint" value="0"/>
      <joint name="wrist_3_joint" value="0"/>
    </group_state>
    <end_effector name="end_effector_and_tool" parent_link="${prefix}tool0" group="${prefix}end_effector" parent_group="${prefix}ur_manipulator"/>
    <virtual_joint name="world" type="fixed" parent_frame="world" child_link="${prefix}floor_link"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}gantry_link" reason="Never"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}left_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}linear_actuator_link" reason="Never"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}linear_actuator_plate_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}pillar_left_link" reason="Never"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}pillar_right_link" reason="Never"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}right_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}arm_mount_plate" link2="${prefix}shoulder_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}gantry_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}left_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}linear_actuator_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}linear_actuator_plate_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}pillar_left_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}pillar_right_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}right_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}upper_arm_link" reason="Never"/>
    <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}wrist_1_link" reason="Never"/>
    <disable_collisions link1="${prefix}forearm_link" link2="${prefix}left_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}forearm_link" link2="${prefix}pillar_left_link" reason="Never"/>
    <disable_collisions link1="${prefix}forearm_link" link2="${prefix}pillar_right_link" reason="Never"/>
    <disable_collisions link1="${prefix}forearm_link" link2="${prefix}right_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}forearm_link" link2="${prefix}upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}forearm_link" link2="${prefix}wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}gantry_link" link2="${prefix}left_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}gantry_link" link2="${prefix}linear_actuator_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}gantry_link" link2="${prefix}linear_actuator_plate_link" reason="Never"/>
    <disable_collisions link1="${prefix}gantry_link" link2="${prefix}pillar_left_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}gantry_link" link2="${prefix}pillar_right_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}gantry_link" link2="${prefix}right_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}gantry_link" link2="${prefix}shoulder_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}linear_actuator_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}linear_actuator_plate_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}pillar_left_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}pillar_right_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}right_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}shoulder_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}tool_center_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}tool_head_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}tool_holder_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}upper_arm_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}wrist_1_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}wrist_2_link" reason="Never"/>
    <disable_collisions link1="${prefix}left_leg_link" link2="${prefix}wrist_3_link" reason="Never"/>
    <disable_collisions link1="${prefix}linear_actuator_link" link2="${prefix}linear_actuator_plate_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}linear_actuator_link" link2="${prefix}pillar_left_link" reason="Never"/>
    <disable_collisions link1="${prefix}linear_actuator_link" link2="${prefix}pillar_right_link" reason="Never"/>
    <disable_collisions link1="${prefix}linear_actuator_link" link2="${prefix}right_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}linear_actuator_link" link2="${prefix}shoulder_link" reason="Never"/>
    <disable_collisions link1="${prefix}linear_actuator_plate_link" link2="${prefix}pillar_left_link" reason="Never"/>
    <disable_collisions link1="${prefix}linear_actuator_plate_link" link2="${prefix}pillar_right_link" reason="Never"/>
    <disable_collisions link1="${prefix}linear_actuator_plate_link" link2="${prefix}right_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}linear_actuator_plate_link" link2="${prefix}shoulder_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_left_link" link2="${prefix}pillar_right_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_left_link" link2="${prefix}right_leg_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_left_link" link2="${prefix}shoulder_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_left_link" link2="${prefix}upper_arm_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_left_link" link2="${prefix}wrist_1_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_left_link" link2="${prefix}wrist_2_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_left_link" link2="${prefix}wrist_3_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}right_leg_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}shoulder_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}tool_center_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}tool_head_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}tool_holder_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}upper_arm_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}wrist_1_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}wrist_2_link" reason="Never"/>
    <disable_collisions link1="${prefix}pillar_right_link" link2="${prefix}wrist_3_link" reason="Never"/>
    <disable_collisions link1="${prefix}right_leg_link" link2="${prefix}shoulder_link" reason="Never"/>
    <disable_collisions link1="${prefix}right_leg_link" link2="${prefix}tool_center_link" reason="Never"/>
    <disable_collisions link1="${prefix}right_leg_link" link2="${prefix}tool_head_link" reason="Never"/>
    <disable_collisions link1="${prefix}right_leg_link" link2="${prefix}tool_holder_link" reason="Never"/>
    <disable_collisions link1="${prefix}right_leg_link" link2="${prefix}upper_arm_link" reason="Never"/>
    <disable_collisions link1="${prefix}right_leg_link" link2="${prefix}wrist_1_link" reason="Never"/>
    <disable_collisions link1="${prefix}right_leg_link" link2="${prefix}wrist_2_link" reason="Never"/>
    <disable_collisions link1="${prefix}right_leg_link" link2="${prefix}wrist_3_link" reason="Never"/>
    <disable_collisions link1="${prefix}shoulder_link" link2="${prefix}upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}shoulder_link" link2="${prefix}wrist_1_link" reason="Never"/>
    <disable_collisions link1="${prefix}tool_center_link" link2="${prefix}tool_head_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}tool_center_link" link2="${prefix}tool_holder_link" reason="Adjacent"/>
    <disable_collisions link1="${prefix}tool_center_link" link2="${prefix}wrist_1_link" reason="Never"/>
    <disable_collisions link1="${prefix}tool_center_link" link2="${prefix}wrist_2_link" reason="Never"/>
    <disable_collisions link1="${prefix}tool_center_link" link2="${prefix}wrist_3_link" reason="Never"/>
    <disable_collisions link1="${prefix}tool_head_link" link2="${prefix}tool_holder_link" reason="Never"/>
    <disable_collisions link1="${prefix}tool_head_link" link2="${prefix}wrist_1_link" reason="Never"/>
    <disable_collisions link1="${prefix}tool_head_link" link2="${prefix}wrist_2_link" reason="Never"/>

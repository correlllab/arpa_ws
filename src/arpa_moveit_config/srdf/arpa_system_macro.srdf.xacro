<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="arpa_system" params="name prefix">
    <!-- ur_manipulator first so Motion Planning plugin defaults to arm-only group -->
    <group name="${prefix}${name}ur_manipulator">
      <chain base_link="${prefix}base_link" tip_link="${prefix}tool0"/>
    </group>
    <group name="linear_actuator_axis">
      <joint name="linear_actuator_to_linear_actuator_plate_joint"/>
    </group>
    <group name="${prefix}end_effector">
      <chain base_link="${prefix}tool0" tip_link="${prefix}ratchet_extension_link"/>
    </group>
    <group_state group="ur_manipulator" name="home">
      <joint name="elbow_joint" value="0"/>
      <joint name="shoulder_lift_joint" value="-1.5707"/>
      <joint name="shoulder_pan_joint" value="0"/>
      <joint name="wrist_1_joint" value="0"/>
      <joint name="wrist_2_joint" value="0"/>
      <joint name="wrist_3_joint" value="0"/>
    </group_state>
    <group name="ur16e_on_gantry">
      <!-- Explicit joint listing ensures all 7 DOF are explored during planning -->
      <joint name="linear_actuator_to_linear_actuator_plate_joint"/>
      <joint name="shoulder_pan_joint"/>
      <joint name="shoulder_lift_joint"/>
      <joint name="elbow_joint"/>
      <joint name="wrist_1_joint"/>
      <joint name="wrist_2_joint"/>
      <joint name="wrist_3_joint"/>
    </group>
    <group_state name="actuator_home" group="linear_actuator_axis">
      <joint name="linear_actuator_to_linear_actuator_plate_joint" value="0.45"/>
    </group_state>
    <group_state name="arm_home" group="ur_manipulator">
      <joint name="elbow_joint" value="2.3387"/>
      <joint name="shoulder_lift_joint" value="-2.6179"/>
      <joint name="shoulder_pan_joint" value="-2.7576"/>
      <joint name="wrist_1_joint" value="-1.29154"/>
      <joint name="wrist_2_joint" value="-4.6949"/>
      <joint name="wrist_3_joint" value="1.1868"/>
    </group_state>
    <group_state name="arpa_home" group="ur16e_on_gantry">
      <joint name="linear_actuator_to_linear_actuator_plate_joint" value="0.45"/>
      <joint name="shoulder_pan_joint" value="-2.7576"/>
      <joint name="shoulder_lift_joint" value="-2.6179"/>
      <joint name="elbow_joint" value="2.3386"/>
      <joint name="wrist_1_joint" value="-1.2915"/>
      <joint name="wrist_2_joint" value="-4.6948"/>
      <joint name="wrist_3_joint" value="1.1868"/>
    </group_state>
    <end_effector name="end_effector_and_tool" parent_link="${prefix}tool0" group="${prefix}end_effector" parent_group="${prefix}ur_manipulator"/>
    <virtual_joint name="world" type="fixed" parent_frame="world" child_link="${prefix}floor_link"/>
    <disable_collisions link1="actuator_motor_link" link2="arm_mount_plate" reason="Never"/>
    <disable_collisions link1="actuator_motor_link" link2="base_link_inertia" reason="Never"/>
    <disable_collisions link1="actuator_motor_link" link2="gantry_link" reason="Default"/>
    <disable_collisions link1="actuator_motor_link" link2="left_leg_link" reason="Never"/>
    <disable_collisions link1="actuator_motor_link" link2="linear_actuator_link" reason="Adjacent"/>
    <disable_collisions link1="actuator_motor_link" link2="linear_actuator_plate_link" reason="Never"/>
    <disable_collisions link1="actuator_motor_link" link2="pillar_left_link" reason="Never"/>
    <disable_collisions link1="actuator_motor_link" link2="pillar_right_link" reason="Never"/>
    <disable_collisions link1="actuator_motor_link" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="actuator_motor_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="arm_mount_plate" link2="base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="arm_mount_plate" link2="gantry_link" reason="Never"/>
    <disable_collisions link1="arm_mount_plate" link2="left_leg_link" reason="Never"/>
    <disable_collisions link1="arm_mount_plate" link2="linear_actuator_link" reason="Never"/>
    <disable_collisions link1="arm_mount_plate" link2="linear_actuator_plate_link" reason="Adjacent"/>
    <disable_collisions link1="arm_mount_plate" link2="pillar_left_link" reason="Never"/>
    <disable_collisions link1="arm_mount_plate" link2="pillar_right_link" reason="Never"/>
    <disable_collisions link1="arm_mount_plate" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="arm_mount_plate" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="gantry_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="left_leg_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="linear_actuator_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="linear_actuator_plate_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="pillar_left_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="pillar_right_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link_inertia" link2="upper_arm_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="left_leg_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="gantry_link" link2="left_leg_link" reason="Never"/>
    <disable_collisions link1="gantry_link" link2="linear_actuator_link" reason="Adjacent"/>
    <disable_collisions link1="gantry_link" link2="linear_actuator_plate_link" reason="Never"/>
    <disable_collisions link1="gantry_link" link2="pillar_left_link" reason="Adjacent"/>
    <disable_collisions link1="gantry_link" link2="pillar_right_link" reason="Adjacent"/>
    <disable_collisions link1="gantry_link" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="gantry_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="linear_actuator_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="linear_actuator_plate_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="pillar_left_link" reason="Adjacent"/>
    <disable_collisions link1="left_leg_link" link2="pillar_right_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="tool_center_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="ratchet_extension_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="tool_holder_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="upper_arm_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="left_leg_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="linear_actuator_link" link2="linear_actuator_plate_link" reason="Adjacent"/>
    <disable_collisions link1="linear_actuator_link" link2="pillar_left_link" reason="Never"/>
    <disable_collisions link1="linear_actuator_link" link2="pillar_right_link" reason="Never"/>
    <disable_collisions link1="linear_actuator_link" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="linear_actuator_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="linear_actuator_plate_link" link2="pillar_left_link" reason="Never"/>
    <disable_collisions link1="linear_actuator_plate_link" link2="pillar_right_link" reason="Never"/>
    <disable_collisions link1="linear_actuator_plate_link" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="linear_actuator_plate_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="pillar_left_link" link2="pillar_right_link" reason="Never"/>
    <disable_collisions link1="pillar_left_link" link2="right_leg_link" reason="Never"/>
    <disable_collisions link1="pillar_left_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="pillar_left_link" link2="upper_arm_link" reason="Never"/>
    <disable_collisions link1="pillar_right_link" link2="right_leg_link" reason="Adjacent"/>
    <disable_collisions link1="pillar_right_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="right_leg_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="right_leg_link" link2="tool_center_link" reason="Never"/>
    <disable_collisions link1="right_leg_link" link2="ratchet_extension_link" reason="Never"/>
    <disable_collisions link1="right_leg_link" link2="tool_holder_link" reason="Never"/>
    <disable_collisions link1="right_leg_link" link2="upper_arm_link" reason="Never"/>
    <disable_collisions link1="right_leg_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="right_leg_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="right_leg_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="tool_center_link" link2="ratchet_extension_link" reason="Adjacent"/>
    <disable_collisions link1="tool_center_link" link2="tool_holder_link" reason="Adjacent"/>
    <disable_collisions link1="tool_center_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="tool_center_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="tool_center_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="ratchet_extension_link" link2="tool_holder_link" reason="Never"/>
    <disable_collisions link1="ratchet_extension_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="ratchet_extension_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="ratchet_extension_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="tool_holder_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="tool_holder_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="tool_holder_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  </xacro:macro>
</robot>


<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="default_materials" params="">
    <material name="pillar_gray">
      <color rgba="0.9 0.9 0.9 1"/>
    </material>
    <material name="gantry_gray">
      <color rgba="0.9 0.9 0.9 1"/>
    </material>
    <material name="actuator_gray">
      <color rgba="0.6 0.6 0.6 1"/>
    </material>
    <material name="camera_black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>
  </xacro:macro>
</robot>
